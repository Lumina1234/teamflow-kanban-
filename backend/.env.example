# ========================
# Database
# ========================
DATABASE_URL=postgresql+asyncpg://kanban:password@localhost:5432/kanban_db
# For sync operations (alembic):
DATABASE_URL_SYNC=postgresql://kanban:password@localhost:5432/kanban_db

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# Security (CHANGE ALL IN PRODUCTION)
# ========================
SESSION_SECRET_KEY=change-me-to-random-64-char-string-in-production

# ========================
# Cookie Settings
# ========================
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# 'strict', 'lax', or 'none' (none requires Secure=true)
COOKIE_SAMESITE=lax

# ========================
# CORS - JSON array of allowed origins
# ========================
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_RESET=3/minute

# ========================
# Application
# ========================
ENVIRONMENT=development
# Options: development, production

# ========================
# Email (for password reset and invitations)
# ========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@example.com
# In development, reset tokens/invitation URLs are logged to console
